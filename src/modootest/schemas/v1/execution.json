{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modootest.dev/schemas/v1/execution.json",
  "title": "modootest Test Execution Result",
  "description": "Execution status and summary for test collection or execution run.",
  "type": "object",
  "required": [
    "$schema",
    "status",
    "executed",
    "collect_only",
    "test_count",
    "returncode",
    "log_file",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://modootest.dev/schemas/v1/execution.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_executed",
        "no_tests_selected",
        "collection_passed",
        "execution_passed",
        "tests_failed",
        "interrupted",
        "pytest_internal_error",
        "pytest_usage_error",
        "no_tests_collected",
        "timeout",
        "launch_error",
        "cancelled",
        "unknown_subprocess_failure"
      ]
    },
    "returncode": {
      "type": ["integer", "null"]
    },
    "executed": {
      "type": "boolean"
    },
    "collect_only": {
      "type": "boolean"
    },
    "test_count": {
      "type": "integer",
      "minimum": 0
    },
    "log_file": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
